#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "This helper must be invoked through its restricted sudo rule." >&2
  exit 1
fi

case "${1:-}" in
  restart-backend)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemctl restart lakshmi-hyundai-backend.service
    ;;
  backend-active)
    [[ $# -eq 1 ]] || exit 2
    exec /usr/bin/systemctl is-active --quiet lakshmi-hyundai-backend.service
    ;;
  startup-check)
    started_at=${2:-}
    [[ $# -eq 2 && "$started_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || {
      echo "Invalid backend restart timestamp." >&2
      exit 2
    }
    recent_logs=$(/usr/bin/journalctl -u lakshmi-hyundai-backend.service --since "$started_at" \
      --output=cat --no-pager) || {
      echo "Unable to inspect recent backend service logs." >&2
      exit 1
    }
    if printf '%s\n' "$recent_logs" |
        /usr/bin/grep -Eq 'Server startup failed:|Error: listen EADDRINUSE|Error: Cannot find module|Cannot find package'; then
      echo "Backend startup failure found in recent service logs." >&2
      exit 1
    fi
    ;;
  migrate-status|migrate-deploy)
    release_id=${2:-}
    [[ $# -eq 2 && "$release_id" =~ ^[0-9a-f]{40}-[0-9]+-[0-9]+$ ]] || {
      echo "Invalid migration release identifier." >&2
      exit 2
    }
    release="/opt/lakshmi-hyundai/releases/$release_id"
    [[ -d "$release/backend" && -f "$release/backend/prisma/schema.prisma" ]] || {
      echo "Migration release does not exist." >&2
      exit 1
    }
    if [[ "$1" == migrate-deploy ]]; then
      exec /usr/bin/systemctl start "lakshmi-hyundai-migrate@${release_id}.service"
    fi
    exec /usr/bin/systemctl start "lakshmi-hyundai-migrate-status@${release_id}.service"
    ;;
  *)
    echo "Unsupported deployment control action." >&2
    exit 2
    ;;
esac

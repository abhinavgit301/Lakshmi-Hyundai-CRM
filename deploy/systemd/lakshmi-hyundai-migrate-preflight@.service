[Unit]
Description=Validate Lakshmi Hyundai CRM migration prerequisites for release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lakshmi-deploy
Group=lakshmi-deploy
EnvironmentFile=/opt/lakshmi-hyundai/shared/migration.env
LoadCredential=database-identity.json:/etc/lakshmi-hyundai/database-identity.json
WorkingDirectory=/opt/lakshmi-hyundai/releases/%i/server
ExecStartPre=+/usr/local/sbin/lakshmi-hyundai-deploy-control verify-database-identity preflight %i %d
ExecStart=/usr/bin/node /opt/lakshmi-hyundai/releases/%i/server/deploy/check-prisma-migrations.mjs preflight %d
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/lakshmi-hyundai/releases/%i
ReadOnlyPaths=/opt/lakshmi-hyundai/shared/migration.env
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true

[Unit]
Description=Check Lakshmi Hyundai CRM Prisma migration status for release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lakshmi-deploy
Group=lakshmi-deploy
EnvironmentFile=/opt/lakshmi-hyundai/shared/backend.env
WorkingDirectory=/opt/lakshmi-hyundai/releases/%i/server
ExecStart=/usr/bin/node /opt/lakshmi-hyundai/releases/%i/server/deploy/check-prisma-migrations.mjs status
ExecStart=/usr/bin/node /opt/lakshmi-hyundai/releases/%i/server/node_modules/prisma/build/index.js migrate status
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/lakshmi-hyundai/releases/%i
ReadOnlyPaths=/opt/lakshmi-hyundai/shared/backend.env
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true

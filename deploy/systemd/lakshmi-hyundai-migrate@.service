[Unit]
Description=Apply committed Lakshmi Hyundai CRM Prisma migrations for release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lakshmi-deploy
Group=lakshmi-deploy
EnvironmentFile=/opt/lakshmi-hyundai/shared/backend.env
WorkingDirectory=/opt/lakshmi-hyundai/releases/%i/server
ExecStartPre=+/usr/bin/node /usr/local/lib/lakshmi-hyundai-deploy/migration-authorization.mjs consume %i
ExecStartPre=/usr/bin/node /opt/lakshmi-hyundai/releases/%i/server/deploy/check-prisma-migrations.mjs apply
ExecStart=/usr/bin/node /opt/lakshmi-hyundai/releases/%i/server/node_modules/prisma/build/index.js migrate deploy
ExecStopPost=+/usr/local/sbin/lakshmi-hyundai-deploy-control cleanup-migration %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/lakshmi-hyundai/releases/%i
ReadOnlyPaths=/opt/lakshmi-hyundai/shared/backend.env
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true

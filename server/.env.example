PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lakshmi_hyundai_crm?schema=public
# IANA timezone used for daily call targets, "yesterday" notices and monthly warranty reporting.
# Must be an IANA id (not "IST" or "+05:30"). Master Call List date maths follow the Node process timezone, so the
# process launcher MUST also set TZ=Asia/Kolkata; startup fails if the two disagree (aliases such as
# Asia/Calcutta are accepted). Do not change PostgreSQL's UTC timezone.
WORKSHOP_TIMEZONE=Asia/Kolkata
# SQL-backed page selection for GET /call-list. Default OFF; only "true" or "1" enable it, anything else keeps the
# original in-memory path. Requires PostgreSQL ICU collation "und-x-icu" (the query fails loudly if it is missing;
# it never falls back to "C"). Other Master Call List consumers (dashboard, due lists, free-service, warranty) are unaffected.
MASTER_CALL_LIST_SQL_ENABLED=false
# Optional conservative candidate narrowing for Master Call List due filters. It retains the existing lifecycle
# classifier and filters in JavaScript; it does not change the service classification rules. Test with representative
# data before enabling, because past-due workloads with many old visits may still require substantial scanning.
MASTER_CALL_LIST_DUE_CANDIDATES_ENABLED=false
# Logs only due category, counts and phase durations; never customer values or search terms.
MASTER_CALL_LIST_DUE_TIMING_LOG=false
# The service-contact-status migration is required before deploying this schema, even when the flag is off:
# other appointment and vehicle queries can select the new nullable columns. Enable the flag after verification.
SERVICE_CONTACT_STATUS_ENABLED=false
# Startup database repairs (Free-Service CRE reassignment and sale-date backfill) WRITE to the database and are
# disabled by default. They only run when this is set to "true"; anything else (or unset) skips them.
RUN_STARTUP_REPAIRS=false

# Performance dashboard aggregates. Both are off by default and need the performance_aggregates migration.
# MAINTAIN keeps the call counters and KPI snapshots up to date (safe to turn on before backfill);
# ENABLED switches the Performance APIs to read them. Rollout: migration, MAINTAIN, backfill, ENABLED.
PERFORMANCE_AGGREGATES_MAINTAIN=false
PERFORMANCE_AGGREGATES_ENABLED=false
